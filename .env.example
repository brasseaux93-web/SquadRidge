# Data adapter: fixture (default) | supabase
NEXT_PUBLIC_DATA_ADAPTER=fixture

# Required only when NEXT_PUBLIC_DATA_ADAPTER=supabase
# Use the anon/public key only in the browser. Never put the service role key here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (local scripts / CI) — DO NOT prefix with NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 to run RLS integration tests against local Supabase
# SUPABASE_INTEGRATION=0
